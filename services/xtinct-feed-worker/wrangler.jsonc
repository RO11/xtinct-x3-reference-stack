{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xtinct-feed-reference",
  "main": "src/index.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "DEVICE_ID": "x3-reference"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xtinct-feed-reference",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "xtinct-feed-reference-artifacts"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}

